# Postgres de Supabase (un proyecto NUEVO, aparte del de hubb).
# Supabase → Project Settings → Database → Connection string → URI.
#
# Usa el "Transaction pooler" (puerto 6543): es el que aguanta serverless.
# La app detecta ese puerto sola y apaga los prepared statements, que el
# pooler en modo transacción no soporta.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Firma de la cookie de sesión. Genera una con:  openssl rand -base64 48
AUTH_SECRET=

# Creativos de anuncios, miniaturas y documentos de Henry.
# Vercel → Storage → Blob → Connect. En local copia el token de ahí.
BLOB_READ_WRITE_TOKEN=

# Copy del pitch e interpretación del documento de estrategia.
ANTHROPIC_API_KEY=

# Ad Library de Meta, perfiles de Instagram y TikTok. https://app.scrapecreators.com
SCRAPECREATORS_API_KEY=

# Buscador de creadores: GET /api/external/creators del hubb desplegado.
#
# CON www. El apex hubb.mx redirige al www y, al ser otro origen, el redirect
# descarta el header Authorization: el token bueno devolvería 401.
HUBB_API_URL=https://www.hubb.mx

# integration_token de hubb con scope creators.read (fila en integration_tokens,
# revocable desde ahí). Lo emite hubb con scripts/mint-app-venta-estrategia-token.ts.
HUBB_API_TOKEN=

# Token que exige /api/public/* para que solo fs.hubb.mx pueda leer los
# entregables publicados. Debe coincidir con PITCH_APP_TOKEN en full_service.
PUBLIC_API_TOKEN=
